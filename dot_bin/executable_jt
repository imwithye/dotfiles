#!/usr/bin/env bash
# jt: JSON (an array, or one object) -> an aligned table of chosen fields.
set -o pipefail

usage() {
  cat <<'EOF'
Usage: <json> | jt [NAME=]path ...
       jt -f FILE [NAME=]path ...

Reads JSON from stdin, or from FILE with -f ("-f -" is stdin). Prints one row
per array element (or one row for a single object), one column per argument.
Each argument is a path, optionally named NAME=path; the header is NAME, or
the path upper-cased.

Paths use "." between keys, or "/" when a key itself contains dots:
  metadata.name
  Config/Labels/com.docker.compose.service

Missing or empty values print "-"; arrays are comma-joined; objects print as JSON.

Examples:
  gh pr list --json number,title,author | jt number title AUTHOR=author.login
  kubectl get pods -o json | jq .items | jt NAME=metadata.name NODE=spec.nodeName PHASE=status.phase
  docker inspect $(docker ps -q) | jt Name SERVICE=Config/Labels/com.docker.compose.service
  jt -f package.json name version
EOF
}

file=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help) usage; exit 0 ;;
    -f | --file)
      [ $# -ge 2 ] || { echo "jt: $1 needs a file" >&2; exit 2; }
      file=$2; shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
done
if [ $# -eq 0 ]; then
  usage >&2
  exit 2
fi

if [ -n "$file" ] && [ "$file" != "-" ]; then
  [ -r "$file" ] || { echo "jt: cannot read $file" >&2; exit 2; }
  exec <"$file"
elif [ -z "$file" ] && [ -t 0 ]; then
  # Without this, jq would sit waiting for JSON typed at the terminal.
  echo "jt: no JSON on stdin; pipe it in (cmd | jt ...) or pass -f FILE" >&2
  exit 2
fi

missing=()
command -v jq >/dev/null 2>&1 || missing+=(jq)
command -v column >/dev/null 2>&1 || missing+=(column)
if [ ${#missing[@]} -gt 0 ]; then
  echo "jt: missing ${missing[*]}; install with one of:" >&2
  echo "  brew install ${missing[*]/column/util-linux}" >&2
  echo "  sudo apt-get install ${missing[*]/column/bsdextrautils}" >&2
  exit 127
fi

input=$(cat)
if [ -z "${input//[[:space:]]/}" ]; then
  # An empty pipe is usually the command before | failing; say so instead of
  # printing nothing at all.
  echo "jt: empty input (did the command before | fail?)" >&2
  exit 1
fi

printf '%s\n' "$input" | jq -r '
  def cell:
    if . == null then "-"
    elif type == "string" then (if . == "" then "-" else gsub("[\t\n]"; " ") end)
    elif type == "array" then (map(if type == "string" then . else tojson end) | join(","))
    else tojson end;
  ($ARGS.positional | map(
    (if test("=") then {h: (split("=")[0]), p: (split("=")[1:] | join("="))} else {h: ., p: .} end)
    | .k = (if (.p | test("/")) then (.p | split("/")) else (.p | split(".")) end))) as $cols
  | ($cols | map(.h | ascii_upcase)),
    ((if type == "array" then .[] else . end) as $row
     | $cols | map(. as $c | $row | (try getpath($c.k) catch null) | cell))
  | @tsv' --args "$@" | column -t -s $'\t'
